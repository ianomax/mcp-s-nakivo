# --- ARS ---
ARS_BASE_URL=https://autoready.readynet.it:23443

# Token Sanctum di ARS
ARS_API_TOKEN=...

ARS_TIMEOUT=120

# --- SEGRETO CONDIVISO CON mcp-c-ars ---
# Lo stesso valore va in NAKIVO_MCP_KEY nel .env del client. Se ne genera uno
# con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=...

# --- STATO DEI BACKUP ---
# Un backup con l'ultimo punto di ripristino piu' vecchio di tante ore e'
# non aggiornato, col pallino giallo; da SOGLIA_BACKUP_ROSSO_ORE in su il
# pallino e' rosso. Come la dashboard di ARS: verde fino a 2 giorni, giallo
# fino a 4.
SOGLIA_BACKUP_ORE=48
SOGLIA_BACKUP_ROSSO_ORE=96

# --- RETE ---
HOST=0.0.0.0
PORT=8010
MCP_PATH=/mcp
